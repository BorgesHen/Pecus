generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PapelUsuario {
  ADMIN
  RESPONSAVEL
  USUARIO
}

/// Define qual bloco de fórmulas (relatorios.service.ts) se aplica ao método,
/// tanto para os métodos globais do seed quanto para os customizados por empresa.
enum TipoMetodoManejo {
  EXTENSIVO
  SEMICONFINAMENTO
  TIP
  CONFINAMENTO
  RECRIA
  NAO_DEFINIDO
}

enum SexoAnimal {
  MACHO
  FEMEA
}

/// Espécie do lote/animal. BOVINO é o padrão histórico; OVINO é liberado por
/// fazenda via recurso personalizado "ovinos".
enum EspecieAnimal {
  BOVINO
  OVINO
}

enum CategoriaAnimal {
  // Bovinos
  BEZERRO
  NOVILHA
  NOVILHO
  VACA
  MATRIZ
  TOURO
  BOI
  // Ovinos
  CORDEIRO
  BORREGO
  MARRA
  OVELHA
  CARNEIRO
  CAPAO
  // Comum
  OUTRO
}

enum StatusAnimal {
  ATIVO
  VENDIDO
  MORTO
  TRANSFERIDO
}

enum TipoEventoSanitario {
  VACINA
  MEDICAMENTO
  EXAME
  /// Avaliação de escores (FAMACHA / condição corporal) — manejo ovino.
  AVALIACAO
  OUTRO
}

enum TipoEventoReprodutivo {
  ESTACAO_MONTA
  INSEMINACAO
  DIAGNOSTICO_GESTACAO
  PARTO
  DESMAME
  DESCARTE
}

enum TipoMovimentoInsumo {
  ENTRADA
  SAIDA
}

enum NaturezaFinanceira {
  RECEITA
  DESPESA
}

enum FormaPagamento {
  PIX
  BOLETO
  FATURA
  DEBITO_AUTOMATICO
  TRANSFERENCIA
  DINHEIRO
  OUTRO
}

enum TipoContato {
  CLIENTE
  FORNECEDOR
  AMBOS
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  documento String? // CPF ou CNPJ
  createdAt DateTime @default(now())

  // Módulos ativos/inativos pra esta fazenda (painel de configuração).
  // Usuários/Pesagens são o núcleo e não têm toggle.
  moduloLotesAtivo         Boolean @default(true)
  moduloGastosAtivo        Boolean @default(true)
  moduloRelatoriosAtivo    Boolean @default(true)
  moduloAnimaisAtivo       Boolean @default(true)
  moduloSanidadeAtivo      Boolean @default(true)
  moduloReproducaoAtivo    Boolean @default(true)
  moduloEstoqueAtivo       Boolean @default(true)
  moduloMetodosManejoAtivo Boolean @default(true)
  moduloAreasAtivo         Boolean @default(true)
  moduloFinanceiroAtivo    Boolean @default(true)

  // Valores-padrão configuráveis pela fazenda.
  rendimentoCarcacaPadrao     Float @default(52)
  sanidadeDiasAvisoVencimento Int   @default(7)
  /// Altura ideal do capim (cm) pra mover o gado pra um piquete, se ele não tiver override próprio.
  alturaIdealPastoPadrao      Float @default(60)

  // Liga/desliga dos valores-padrão acima. Desligado, o sistema para de usar
  // aquele parâmetro: sem aviso de vencimento sanitário (dashboard e tela de
  // Sanidade) e sem comparação de altura ideal do capim (status "pronto pra
  // receber o gado" nos piquetes). Os registros em si continuam existindo.
  avisoVencimentoSanitarioAtivo Boolean @default(true)
  alturaIdealPastoAtiva         Boolean @default(true)

  // Campos opcionais desativados por tela (painel de configuração), formato
  // "tela.campo" (ex: "lotes.rendimentoCarcaca"). Ver packages/shared
  // TELAS_CAMPOS_CONFIGURAVEIS pra lista de chaves válidas.
  camposDesativados Json @default("[]")

  // Recursos sob encomenda liberados só pra essa fazenda — controlado
  // exclusivamente pelo ADMIN (tela "Recursos personalizados"), diferente
  // dos módulos padrão acima. Array de chaves de packages/shared
  // RECURSOS_PERSONALIZADOS.
  recursosPersonalizados Json @default("[]")

  // Localização usada na previsão do tempo do painel. Fica na fazenda (e não
  // no usuário) porque é a mesma pra todo mundo que trabalha nela — e o
  // produtor costuma acessar o sistema de casa ou da cidade, longe do lugar
  // que ele quer acompanhar. Nulo = ainda não definida (aí a previsão usa a
  // localização do navegador). Os três andam juntos: ou todos preenchidos, ou
  // todos nulos.
  climaLocalNome String?
  climaLatitude  Float?
  climaLongitude Float?

  usuarios            UsuarioEmpresa[]
  lotes               Lote[]
  areas               Area[]
  gastos              Gasto[]
  metodosManejo       MetodoManejo[]
  animais             Animal[]
  eventosSanitarios   EventoSanitario[]
  eventosReprodutivos EventoReprodutivo[]
  insumos             Insumo[]
  movimentosInsumo    MovimentoInsumo[]
  gruposFinanceiros   GrupoFinanceiro[]
  contasBancarias     ContaBancaria[]
  contatos            Contato[]
  lancamentos         Lancamento[]
  atividades          RegistroAtividade[]
}

/// Convite de acesso: uma fazenda nova só consegue se cadastrar (/auth/registrar)
/// informando um código de convite válido e ainda não usado. Gerado pelo ADMIN
/// depois de fechar o negócio com o cliente — controla quem pode criar conta.
model ConviteCadastro {
  id         String    @id @default(uuid())
  codigo     String    @unique
  observacao String?
  usadoEm    DateTime?
  createdAt  DateTime  @default(now())
}

/// Registro de tentativas de login (sucesso e falha) — usado só pra rate
/// limiting contra força bruta. Guarda o texto digitado em "usuario", que
/// pode nem corresponder a uma conta real; sem relação com o model Usuario.
model TentativaLogin {
  id        String   @id @default(uuid())
  usuario   String
  ip        String
  sucesso   Boolean
  createdAt DateTime @default(now())

  @@index([usuario, createdAt])
  @@index([ip, createdAt])
}

model Usuario {
  id          String       @id @default(uuid())
  nome        String
  email       String       @unique
  /// Usado para login (em vez do e-mail). Ex: "joao.silva"
  usuario     String       @unique
  senhaHash   String
  /// Papel global. Só ADMIN é global (suporte do sistema).
  /// Para RESPONSAVEL/USUARIO o papel real vem de UsuarioEmpresa.
  papelGlobal PapelUsuario @default(USUARIO)
  createdAt   DateTime     @default(now())

  // ----- Ciclo de vida da senha -----
  // Conta criada pelo responsável (ou senha resetada) nasce com senha
  // provisória: entra no sistema, mas o app só libera as telas depois que a
  // pessoa define a senha dela. Assim o responsável nunca conhece a senha
  // definitiva de ninguém.
  senhaProvisoria                Boolean   @default(false)
  /// Provisória tem prazo. Vencida, o login é recusado e a pessoa pede outra
  /// pela tela de login ("Esqueci minha senha").
  senhaProvisoriaExpiraEm        DateTime?
  /// A provisória saiu por e-mail (e não copiada à mão pelo responsável). É o
  /// que permite tratar a troca de senha como prova de que o e-mail existe.
  senhaProvisoriaEnviadaPorEmail Boolean   @default(false)
  /// Preenchido quando a pessoa define a senha a partir de uma provisória que
  /// chegou por e-mail — ou seja, ela recebeu a mensagem naquele endereço.
  emailVerificadoEm              DateTime?

  empresas UsuarioEmpresa[]
}

/// Vínculo N:N entre usuário e empresa, guardando o papel e as permissões
/// granulares que o RESPONSAVEL define para cada USUARIO.
model UsuarioEmpresa {
  id         String       @id @default(uuid())
  usuarioId  String
  empresaId  String
  papel      PapelUsuario
  /// Ex: { "lotes": "editar", "gastos": "ver", "relatorios": "nenhum" }
  permissoes Json?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
}

model MetodoManejo {
  id        String           @id @default(uuid())
  nome      String
  /// null = método global (seed). Preenchido = método customizado da fazenda.
  empresaId String?
  tipo      TipoMetodoManejo @default(NAO_DEFINIDO)

  empresa    Empresa?              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lotes      Lote[]
  historicos LoteMetodoHistorico[]
}

model Lote {
  id                String        @id @default(uuid())
  empresaId         String
  metodoManejoId    String?
  areaId            String?
  identificacao     String
  /// Define categorias válidas dos animais e os cálculos de carcaça/GMD do lote.
  especie           EspecieAnimal @default(BOVINO)
  dataAquisicao     DateTime
  quantidadeAnimais Int
  pesoMedioEntrada  Float? // kg
  /// % que vira carcaça. Se nulo, usa o padrão da espécie (bovino 52, ovino 45).
  rendimentoCarcaca Float?

  // ----- Dados da compra (simulador de aquisição) -----
  // Servem duas vezes: pra decidir se o negócio fecha, antes do lote existir, e
  // depois como base do custo do lote. `pesoMedioCompra` é separado de
  // `pesoMedioEntrada` de propósito — o peso negociado na compra e o peso quando
  // o gado entra na pastagem são eventos diferentes (a planilha do produtor tem
  // as duas colunas), então corrigir um não pode mexer no custo do outro.
  // Frete e comissão ficam sempre por cabeça (rateados), como na planilha.
  pesoMedioCompra   Float? // kg
  valorKgCompra     Float? // R$/kg negociado
  fretePorCabeca    Float? // R$
  comissaoPorCabeca Float? // R$
  gmdEsperado       Float? // kg/dia — meta de referência p/ comparar com o GMD real
  createdAt         DateTime @default(now())

  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  metodoManejo    MetodoManejo?         @relation(fields: [metodoManejoId], references: [id])
  area            Area?                 @relation(fields: [areaId], references: [id], onDelete: SetNull)
  pesagens        Pesagem[]
  gastos          Gasto[]
  metodoHistorico LoteMetodoHistorico[]
  animais         Animal[]
  lancamentos     Lancamento[]
}

/// Área de pasto — separada do Lote (que é só organização de animais). Se
/// subdivide em Piquetes pra pastejo rotacionado.
model Area {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String
  areaHectares Float?
  createdAt    DateTime @default(now())

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lotes    Lote[]
  piquetes Piquete[]
}

/// Subdivisão da área de pasto (pastejo rotacionado).
model Piquete {
  id            String   @id @default(uuid())
  areaId        String
  nome          String
  areaHectares  Float?
  /// Override por piquete; se nulo, usa Empresa.alturaIdealPastoPadrao.
  alturaIdealCm Float?
  createdAt     DateTime @default(now())

  area            Area                  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  registrosAltura RegistroAlturaPasto[]
  ocupacoes       OcupacaoPiquete[]
}

/// Medição da altura do capim num piquete ("controle do pasto").
model RegistroAlturaPasto {
  id        String   @id @default(uuid())
  piqueteId String
  data      DateTime
  alturaCm  Float
  createdAt DateTime @default(now())

  piquete Piquete @relation(fields: [piqueteId], references: [id], onDelete: Cascade)
}

/// Fase em que o piquete concentrou o gado do lote. dataFim nula = ocupado agora.
model OcupacaoPiquete {
  id         String    @id @default(uuid())
  piqueteId  String
  dataInicio DateTime
  dataFim    DateTime?

  piquete Piquete @relation(fields: [piqueteId], references: [id], onDelete: Cascade)
}

/// Cadastro individual do animal — complementar ao Lote (que continua sendo a
/// unidade de custo/produtividade). Serve de ancoragem para Sanidade e
/// Reprodução; não substitui Lote.quantidadeAnimais nem Pesagem/Gasto do lote.
model Animal {
  id             String          @id @default(uuid())
  empresaId      String
  loteId         String?
  /// Brinco/identificador — único dentro da empresa.
  identificador  String
  /// Herdada do lote quando o animal é cadastrado dentro de um.
  especie        EspecieAnimal   @default(BOVINO)
  sexo           SexoAnimal
  categoria      CategoriaAnimal
  dataNascimento DateTime?
  dataEntrada    DateTime
  pesoEntrada    Float?
  status         StatusAnimal    @default(ATIVO)
  dataSaida      DateTime?
  motivoSaida    String?
  observacao     String?
  createdAt      DateTime        @default(now())

  empresa             Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lote                Lote?               @relation(fields: [loteId], references: [id])
  eventosSanitarios   EventoSanitario[]
  eventosReprodutivos EventoReprodutivo[] @relation("EventoReprodutivoAnimal")
  nascimentosComoCria EventoReprodutivo[] @relation("EventoReprodutivoCria")
  pesagens            PesagemAnimal[]

  @@unique([empresaId, identificador])
  /// O acompanhamento do lote pergunta exatamente isto: os animais ativos de um lote.
  @@index([empresaId, loteId, status])
}

model EventoSanitario {
  id               String              @id @default(uuid())
  empresaId        String
  animalId         String
  tipo             TipoEventoSanitario
  nome             String
  data             DateTime
  proximaAplicacao DateTime?

  // ----- Insumo aplicado (o que liga o manejo ao estoque e ao custo do bicho) -----
  // Opcionais: manejo sem produto existe (exame, avaliação de escore) e os
  // eventos lançados antes disso não têm como preencher.
  insumoId          String?
  /// Quantidade consumida, SEMPRE na unidade de cadastro do insumo (0.005 quando
  /// se aplicou 5 ml de um produto cadastrado em litro). Guardar na unidade base
  /// é o que permite somar com o saldo do estoque sem converter de novo.
  quantidadeInsumo  Float?
  /// A unidade que o produtor escolheu no lançamento ("ml"). Só pra exibir o
  /// evento como ele foi digitado — a conta usa `quantidadeInsumo`.
  unidadeInsumo     String?
  /// Custo do insumo aplicado, congelado no dia da aplicação. É snapshot de
  /// propósito: o custo médio do estoque muda a cada compra nova, e o que este
  /// animal custou não pode mudar retroativamente. Nulo = insumo sem valor de
  /// compra conhecido.
  custo             Decimal?            @db.Decimal(12, 2)
  /// A saída de estoque que esta aplicação gerou. Numa aplicação em massa, os
  /// eventos de todos os animais apontam pro mesmo movimento (uma baixa só, com
  /// o total consumido — 50 linhas no extrato do estoque por uma vacinação
  /// tornariam o extrato ilegível).
  movimentoInsumoId String?
  /// Grau FAMACHA 1-5 (cor da mucosa ocular) — manejo ovino, base do
  /// tratamento seletivo contra verminose.
  escoreFamacha    Int?
  /// Escore de condição corporal 1-5 (aceita meio ponto).
  escoreCorporal   Float?
  observacao       String?
  createdAt        DateTime            @default(now())

  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  animal          Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  insumo          Insumo?          @relation(fields: [insumoId], references: [id])
  movimentoInsumo MovimentoInsumo? @relation(fields: [movimentoInsumoId], references: [id])

  // Sem índice nenhum até aqui. Estes são os três caminhos de leitura que a tela
  // do animal e o acompanhamento do lote usam.
  @@index([empresaId, animalId, data])
  @@index([empresaId, data])
  @@index([empresaId, proximaAplicacao])
}

/// Evento reprodutivo ligado à matriz/touro (animalId). Quando tipo = PARTO e a
/// cria já foi cadastrada como Animal, criaId aponta pra ela.
model EventoReprodutivo {
  id          String                @id @default(uuid())
  empresaId   String
  animalId    String
  tipo        TipoEventoReprodutivo
  data        DateTime
  resultado   String?
  /// Primeira cria do parto. Em parto múltiplo (comum em ovinos) as demais
  /// crias são cadastradas como Animal e contabilizadas em numeroCrias.
  criaId      String?
  /// Nº de crias nascidas — base da prolificidade (crias por parto).
  numeroCrias Int?
  observacao  String?
  createdAt   DateTime              @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  animal  Animal  @relation("EventoReprodutivoAnimal", fields: [animalId], references: [id], onDelete: Cascade)
  cria    Animal? @relation("EventoReprodutivoCria", fields: [criaId], references: [id])
}

/// Uma linha por período em que o lote esteve num método de manejo.
/// dataFim = null → fase atual (em andamento).
model LoteMetodoHistorico {
  id             String    @id @default(uuid())
  loteId         String
  metodoManejoId String
  dataInicio     DateTime
  dataFim        DateTime?

  lote         Lote         @relation(fields: [loteId], references: [id], onDelete: Cascade)
  metodoManejo MetodoManejo @relation(fields: [metodoManejoId], references: [id])
}

model Pesagem {
  id        String   @id @default(uuid())
  loteId    String
  data      DateTime
  pesoMedio Float // kg
  createdAt DateTime @default(now())

  lote Lote @relation(fields: [loteId], references: [id], onDelete: Cascade)
}

/// Pesagem de um animal específico. Separada de `Pesagem`, que guarda a média
/// do lote: aqui cada linha é o peso de um bicho, e é esse histórico que
/// sustenta o GMD individual.
///
/// A última pesagem é o peso atual do animal — e, quando ele sai (venda,
/// morte, transferência), é o peso de saída. Não existe coluna separada de
/// "peso de saída" de propósito: seriam dois lugares para o mesmo número,
/// livres para divergir.
model PesagemAnimal {
  id         String   @id @default(uuid())
  animalId   String
  data       DateTime
  peso       Float // kg
  observacao String?
  createdAt  DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  // Sem empresaId: o escopo por fazenda vem do animal, como em Pesagem (que
  // depende do lote).
  @@index([animalId, data])
}

model Gasto {
  id         String   @id @default(uuid())
  empresaId  String
  loteId     String?
  insumoId   String? // se informado, o valor lançado dá entrada no estoque desse insumo
  categoria  String
  descricao  String?
  valor      Decimal  @db.Decimal(12, 2)
  quantidade Float? // ex: litros, sacos, kg
  unidade    String? // ex: "L", "kg", "saco"
  data       DateTime
  createdAt  DateTime @default(now())

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lote             Lote?             @relation(fields: [loteId], references: [id])
  insumo           Insumo?           @relation(fields: [insumoId], references: [id])
  movimentosInsumo MovimentoInsumo[]

  @@index([empresaId, loteId])
}

model Insumo {
  id            String   @id @default(uuid())
  empresaId     String
  nome          String
  unidade       String
  estoqueMinimo Float?
  createdAt     DateTime @default(now())

  empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimentos        MovimentoInsumo[]
  gastos            Gasto[]
  eventosSanitarios EventoSanitario[]

  @@unique([empresaId, nome])
}

model MovimentoInsumo {
  id         String              @id @default(uuid())
  empresaId  String
  insumoId   String
  tipo       TipoMovimentoInsumo
  /// Sempre na unidade de cadastro do insumo — ver unidades.ts.
  quantidade Float
  data       DateTime
  /// Quanto este movimento vale em reais.
  ///
  /// Na ENTRADA é o que se pagou (vem do gasto da compra, ou digitado na entrada
  /// manual). É daqui que sai o custo médio do insumo: soma dos valores ÷ soma
  /// das quantidades. Nulo = entrada sem valor (saldo inicial, ajuste de
  /// inventário, doação), que fica fora da média em vez de entrar como zero.
  ///
  /// Na SAÍDA é o custo do que saiu, ao custo médio do dia — é o que permite
  /// dizer quanto os 5 ml aplicados naquele animal custaram.
  valorTotal Decimal?            @db.Decimal(12, 2)
  gastoId    String?
  observacao String?
  createdAt  DateTime            @default(now())

  empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  insumo            Insumo            @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  gasto             Gasto?            @relation(fields: [gastoId], references: [id])
  eventosSanitarios EventoSanitario[]

  @@index([empresaId, insumoId, tipo])
  @@index([insumoId, data])
}

/// Grupo de nível 1 do plano de contas financeiro (ex: "Custos Variáveis").
/// Sempre pertence a uma empresa (permite ativar/desativar conta por conta
/// sem afetar outras fazendas — por isso não é global como MetodoManejo).
model GrupoFinanceiro {
  id        String             @id @default(uuid())
  empresaId String
  natureza  NaturezaFinanceira
  codigo    String
  nome      String
  ordem     Int                @default(0)

  empresa Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contas  ContaFinanceira[]

  @@unique([empresaId, codigo])
}

/// Subcategoria de nível 2 do plano de contas (ex: "Ração").
model ContaFinanceira {
  id      String  @id @default(uuid())
  grupoId String
  codigo  String
  nome    String
  ativo   Boolean @default(true)

  grupo       GrupoFinanceiro @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  lancamentos Lancamento[]

  @@unique([grupoId, codigo])
}

model ContaBancaria {
  id               String    @id @default(uuid())
  empresaId        String
  nome             String
  saldoInicial     Decimal   @default(0) @db.Decimal(14, 2)
  dataSaldoInicial DateTime?
  ativo            Boolean   @default(true)

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lancamentos Lancamento[]
}

model Contato {
  id        String      @id @default(uuid())
  empresaId String
  tipo      TipoContato
  nome      String
  documento String?
  telefone  String?
  email     String?

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lancamentos Lancamento[]
}

/// Lançamento financeiro (conta a pagar/receber). Lançamentos parcelados são
/// expandidos em N linhas na criação — cada parcela é sua própria linha,
/// independente (ver financeiro/lancamentos.service.ts).
model Lancamento {
  id              String          @id @default(uuid())
  empresaId       String
  contaId         String
  loteId          String? // "projeto" — null = geral/consolidado da fazenda
  contatoId       String?
  contaBancariaId String?
  formaPagamento  FormaPagamento?
  descricao       String?
  documento       String?

  valorTotal    Decimal @db.Decimal(14, 2)
  totalParcelas Int     @default(1)
  numeroParcela Int     @default(1)
  valorParcela  Decimal @db.Decimal(14, 2)

  dataDocumento  DateTime
  dataVencimento DateTime
  /// Pago (SAÍDA) ou recebido (ENTRADA); null = em aberto.
  dataLiquidacao DateTime?

  empresa       Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  conta         ContaFinanceira @relation(fields: [contaId], references: [id])
  lote          Lote?           @relation(fields: [loteId], references: [id])
  contato       Contato?        @relation(fields: [contatoId], references: [id])
  contaBancaria ContaBancaria?  @relation(fields: [contaBancariaId], references: [id])

  @@index([empresaId, dataDocumento])
  @@index([empresaId, dataLiquidacao])
}

/// Tipo de ação registrada na trilha de atividades.
///
/// MOVIMENTACAO existe separada de ATUALIZACAO porque é o que o produtor
/// procura no dia a dia: gado que trocou de piquete, animal que saiu do
/// rebanho, insumo que entrou ou saiu do estoque, parcela liquidada. Tudo isso
/// é tecnicamente um UPDATE, mas ninguém abre o log pra ver "um UPDATE".
enum AcaoAtividade {
  CRIACAO
  ATUALIZACAO
  EXCLUSAO
  MOVIMENTACAO
}

/// Trilha de auditoria da fazenda: quem fez o quê e quando. Alimenta a tela
/// "Atividades" e os botões de "Histórico" espalhados pelo sistema.
///
/// A tabela só recebe INSERT — o app nunca edita nem apaga linha daqui, senão
/// o log deixaria de servir como registro do que aconteceu. É também por isso
/// que a descrição vem pronta e o autor fica copiado: o registro de origem
/// pode não existir mais (é justamente o caso das exclusões) e a conta do
/// autor pode ter saído da fazenda.
model RegistroAtividade {
  id         String        @id @default(uuid())
  empresaId  String
  acao       AcaoAtividade
  /// Que tipo de registro foi afetado — valores de EntidadeAtividade
  /// (packages/shared). String, e não enum, pra que um módulo novo apareça no
  /// log sem precisar de migration.
  entidade   String
  /// Id do registro afetado. É o que o botão "Histórico" das telas de detalhe
  /// usa pra filtrar. Nulo quando a ação não tem um registro único (ex:
  /// aplicação sanitária em massa, alteração das configurações da fazenda).
  registroId String?
  /// Id do registro "dono" do evento, quando o afetado vive dentro de outro:
  /// uma pesagem tem `registroId` = id da pesagem e `contextoId` = id do
  /// animal. Sem isso o histórico do animal não teria como mostrar as pesagens
  /// dele — o id da pesagem não bate com o id do animal. Coluna separada, e não
  /// `registroId` sobrescrito, pra que "qual registro esta linha alterou?"
  /// continue tendo uma resposta só.
  contextoId String?
  /// Texto pronto pra ler: "Lote 25/26 A excluído".
  descricao  String
  /// Complemento opcional (campos alterados, quantidades). Nunca guarda senha,
  /// hash ou token.
  detalhes   Json?

  /// Quem fez. Sem relação com Usuario de propósito: se a conta for removida
  /// da fazenda, o log tem que continuar dizendo quem foi.
  autorId    String?
  autorNome  String
  autorEmail String?

  createdAt DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, createdAt])
  @@index([empresaId, entidade, createdAt])
  @@index([empresaId, entidade, registroId])
  @@index([empresaId, contextoId])
  @@index([empresaId, acao, createdAt])
}
