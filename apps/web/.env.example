# Conexão com o PostgreSQL (ajuste conforme seu ambiente)
# No Supabase: DATABASE_URL = pooler em modo "Session" (mesmo host do pooler, porta 5432) —
#              o modo "Transaction" (porta 6543) NÃO suporta as transações interativas
#              que este app usa ($transaction com callback), então não use esse aqui.
#              DIRECT_URL  = "Connection string" direta (porta 5432 do host do banco) — só as migrations usam essa
DATABASE_URL="postgresql://pecus:pecus@localhost:5432/pecus?schema=public"
DIRECT_URL="postgresql://pecus:pecus@localhost:5432/pecus?schema=public"

# Segredo para assinar os tokens JWT (troque por algo aleatório e longo)
JWT_SECRET="troque-este-segredo-por-uma-string-aleatoria-longa"
JWT_EXPIRES_IN="7d"
