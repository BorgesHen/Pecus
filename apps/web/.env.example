# ---------- Banco de dados ----------
# Conexão com o PostgreSQL (ajuste conforme seu ambiente).
#
# No Supabase:
#   DATABASE_URL = pooler em modo "Transaction" (porta 6543) + ?pgbouncer=true&connection_limit=5
#                  As transações interativas do app ($transaction com callback) FUNCIONAM nesse
#                  modo — foi medido. Já o modo "Session" (pooler na porta 5432) tem
#                  pool_size 15 e cada conexão do Prisma ocupa um slot pra sempre: os slots
#                  acabam e a API passa a responder "Erro interno" em todas as telas.
#   DIRECT_URL   = connection string direta (porta 5432 do host do banco) — só as migrations usam.
DATABASE_URL="postgresql://pecus:pecus@localhost:5432/pecus?schema=public"
DIRECT_URL="postgresql://pecus:pecus@localhost:5432/pecus?schema=public"

# ---------- Sessão ----------
# Segredo para assinar os tokens JWT (troque por algo aleatório e longo)
JWT_SECRET="troque-este-segredo-por-uma-string-aleatoria-longa"
JWT_EXPIRES_IN="7d"

# ---------- Envio de e-mail (SMTP) ----------
# Usado para mandar as credenciais de acesso e as senhas provisórias.
#
# SEM ISSO O SISTEMA CONTINUA FUNCIONANDO: a senha provisória aparece na tela de
# Usuários pro responsável repassar à mão. O que não funciona sem SMTP é o
# "Esqueci minha senha" da tela de login, que depende do e-mail pra entregar.
#
# Funciona com qualquer provedor SMTP. Exemplos de host/porta:
#   Resend    -> smtp.resend.com : 587   (SMTP_USER = "resend", SMTP_PASS = a API key)
#   SendGrid  -> smtp.sendgrid.net : 587 (SMTP_USER = "apikey", SMTP_PASS = a API key)
#   Amazon SES-> email-smtp.<regiao>.amazonaws.com : 587
#   Gmail/Workspace -> smtp.gmail.com : 587 (exige senha de app)
#
# Importante: o domínio do EMAIL_REMETENTE precisa de SPF e DKIM configurados no
# DNS, senão a mensagem cai no spam (ou é recusada).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_REMETENTE="Pecus 360 <nao-responda@pecus.net.br>"

# Endereço público do app — entra no link "Entrar no Pecus 360" dos e-mails.
NEXT_PUBLIC_URL_APP="https://www.pecus.net.br"
