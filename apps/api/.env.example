# Conexão com o PostgreSQL (ajuste conforme seu ambiente)
DATABASE_URL="postgresql://pecus:pecus@localhost:5432/pecus?schema=public"

# Segredo para assinar os tokens JWT (troque por algo aleatório e longo)
JWT_SECRET="troque-este-segredo-por-uma-string-aleatoria-longa"
JWT_EXPIRES_IN="7d"

# Porta da API
PORT=3333
